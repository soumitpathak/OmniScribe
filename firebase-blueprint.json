{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last sign-in timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "AuditRecord": {
      "title": "AuditRecord",
      "description": "Cross-border logistics audit record saved by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Audit document ID"
        },
        "userId": {
          "type": "string",
          "description": "User UID who generated the audit"
        },
        "auditId": {
          "type": "string",
          "description": "Audit reference code"
        },
        "destinationCountry": {
          "type": "string",
          "description": "Destination customs country code"
        },
        "documentType": {
          "type": "string",
          "description": "Document type audited"
        },
        "auditStatus": {
          "type": "string",
          "enum": ["APPROVED", "FLAGGED", "REJECTED"],
          "description": "Clearance status"
        },
        "riskScore": {
          "type": "integer",
          "description": "Risk score between 0 and 100"
        },
        "riskLevel": {
          "type": "string",
          "description": "Risk category LOW, MODERATE, CRITICAL"
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp ISO string"
        },
        "fileName": {
          "type": "string",
          "description": "Filename of audited document"
        },
        "summary": {
          "type": "string",
          "description": "Brief summary of results"
        },
        "fullAuditJson": {
          "type": "string",
          "description": "Full serialized audit JSON payload for client hydration"
        }
      },
      "required": ["id", "userId", "auditId", "destinationCountry", "auditStatus", "riskScore", "riskLevel", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document keyed by auth UID"
    },
    "/users/{userId}/audits/{auditRecordId}": {
      "schema": "AuditRecord",
      "description": "Subcollection of logistics audit history records owned by user"
    }
  }
}
