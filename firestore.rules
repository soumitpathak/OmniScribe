rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket enumeration forbidden
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid
                    && incoming().keys().hasAll(['uid', 'email', 'createdAt'])
                    && incoming().uid is string
                    && incoming().email is string
                    && incoming().email.size() <= 256;
      allow update: if isOwner(userId)
                    && incoming().uid == existing().uid
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt']);
      allow delete: if false;

      // Subcollection: User's saved audits
      match /audits/{auditRecordId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(auditRecordId)
                      && incoming().userId == request.auth.uid
                      && incoming().keys().hasAll(['id', 'userId', 'auditId', 'destinationCountry', 'auditStatus', 'riskScore', 'riskLevel', 'timestamp'])
                      && incoming().riskScore is int
                      && incoming().riskScore >= 0
                      && incoming().riskScore <= 100;
        allow update: if isOwner(userId)
                      && incoming().userId == existing().userId
                      && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }
    }
  }
}
