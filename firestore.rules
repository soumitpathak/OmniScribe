rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isVerified() && (request.auth.token.email == 'soumitpathak01@gmail.com' || request.auth.token.email == 'bababridge@gmail.com');
    }

    function isAdmin() {
      return isSuperAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'company', 'createdAt', 'lastLoginAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['ADMIN', 'OFFICER', 'BROKER', 'Logistics Compliance Officer', 'Customs Broker', 'Supply Chain Director', 'Auditor'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('company' in data) || (data.company is string && data.company.size() <= 128));
    }

    function isValidAudit(data) {
      return data.keys().hasAll(['audit_id', 'audit_status', 'risk_score', 'risk_level', 'destination_country', 'author_uid']) &&
             data.audit_id is string && data.audit_id.size() <= 128 &&
             data.audit_status in ['APPROVED', 'FLAGGED', 'REJECTED'] &&
             data.risk_score is number && data.risk_score >= 0 && data.risk_score <= 100 &&
             data.risk_level in ['LOW', 'MODERATE', 'CRITICAL'] &&
             data.destination_country is string && data.destination_country.size() <= 64 &&
             data.author_uid is string && data.author_uid == request.auth.uid &&
             (!('document_file_name' in data) || (data.document_file_name is string && data.document_file_name.size() <= 256)) &&
             (!('regulatory_framework' in data) || (data.regulatory_framework is string && data.regulatory_framework.size() <= 256));
    }

    function isValidComment(data, auditId) {
      return data.keys().hasAll(['id', 'audit_id', 'author_uid', 'author_name', 'content']) &&
             data.id is string && data.id.size() <= 128 &&
             data.audit_id == auditId &&
             data.author_uid == request.auth.uid &&
             data.author_name is string && data.author_name.size() <= 128 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             (!('author_role' in data) || (data.author_role is string && data.author_role.size() <= 128)) &&
             (!('author_avatar_color' in data) || (data.author_avatar_color is string && data.author_avatar_color.size() <= 128)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
             (!('priority' in data) || (data.priority in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'])) &&
             (!('resolved' in data) || (data.resolved is bool)) &&
             (!('is_pinned' in data) || (data.is_pinned is bool));
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isVerified() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Users Collection (PII Isolation: read own profile or admin)
    match /users/{userId} {
      allow get: if isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && request.auth.uid == userId && isValidUser(incoming()) &&
                    (incoming().role != 'ADMIN' || isSuperAdmin());
      allow update: if isVerified() && isValidUser(incoming()) && (
        (request.auth.uid == userId && incoming().role == existing().role &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Audits Collection
    match /audits/{auditId} {
      allow get: if isVerified() && isValidId(auditId);
      allow list: if isVerified();
      allow create: if isVerified() && isValidId(auditId) && isValidAudit(incoming());
      allow update: if isVerified() && isValidId(auditId) && isValidAudit(incoming()) && (
        isAdmin() ||
        (existing().author_uid == request.auth.uid && incoming().author_uid == existing().author_uid)
      );
      allow delete: if isAdmin();

      // Subcollection: Threaded Comments
      match /comments/{commentId} {
        allow get: if isVerified() && isValidId(commentId);
        allow list: if isVerified();
        allow create: if isVerified() && isValidId(commentId) &&
                      exists(/databases/$(database)/documents/audits/$(auditId)) &&
                      isValidComment(incoming(), auditId);
        allow update: if isVerified() && isValidId(commentId) &&
                      isValidComment(incoming(), auditId) && (
                        isAdmin() ||
                        (existing().author_uid == request.auth.uid &&
                         incoming().author_uid == existing().author_uid &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['content', 'resolved', 'is_pinned', 'priority', 'category', 'updated_at']))
                      );
        allow delete: if isVerified() && (isAdmin() || existing().author_uid == request.auth.uid);
      }
    }
  }
}
